{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task Manager Remake",
  "identifier": "dev.findiepman.taskmanager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Task Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "theme": "Dark",
        "backgroundColor": "#121212",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A cleaner Windows task manager",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "resources": {
      "resources/pawnio/PawnIO_setup.exe": "PawnIO_setup.exe",
      "resources/pawnio/COPYING": "licenses/PawnIO-modules-COPYING.txt"
    }
  }
}